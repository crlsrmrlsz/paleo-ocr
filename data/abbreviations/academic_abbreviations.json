{
  "metadata": {
    "description": "Structured abbreviations from authoritative academic/institutional sources for Spanish paleography (1300-1700). Compiled for the paleo-ocr HTR evaluation project.",
    "date_compiled": "2026-03-27",
    "notes": [
      "Abbreviated forms may appear in manuscripts without diacritics or tildes shown here.",
      "Categories: legal (judicial/notarial), administrative (governance), religious, titles (honorifics/forms of address), economic (commerce/money), military, temporal (dates/time), kinship, geographic, common (frequent words).",
      "The CHARTA angle-bracket convention marks resolved letters: d<ic>ho means the scribe wrote 'dho' and 'ic' was expanded by the editor."
    ]
  },
  "sources": [
    {
      "id": "carlin_1999",
      "citation": "Carlin, A. Roberta. A Paleographic Guide to Spanish Abbreviations 1500-1700. Universal Publishers, 1999. ISBN 1-58112-571-2.",
      "url": "https://www.bookpump.com/upb/pdf-b/1125712b.pdf",
      "description": "Over 1000 abbreviations scanned from original Spanish documents 1500-1700. Book preview provides entries A-B plus methodology.",
      "access": "Book preview PDF (25 pages of ~200). Full book is commercially available."
    },
    {
      "id": "charta_2013",
      "citation": "Red Internacional CHARTA. Criterios de edicion de documentos hispanicos (Origenes-siglo XIX). Version April 2013.",
      "url": "https://corpora.uah.es/charta/web/Criterios_CHARTA_11abr2013.pdf",
      "description": "Official transcription criteria for the CHARTA network, which governs CODEA ground truth production.",
      "access": "Full PDF, 39 pages, freely available."
    },
    {
      "id": "tolosa_gimenez_2006",
      "citation": "Tolosa Robledo, L., Gimenez Chornet, V., Tanodi de Chiapero, B., & Rufeil Zarzur, M. Braquigrafia de la documentacion economica hispanoamericana. Universidad Politecnica de Valencia.",
      "url": "https://www.vicentgimenez.net/curri/braquigrafia.pdf",
      "description": "Systematic extraction of abbreviations from an 18th-century economic document (residencia of the Governor of Tucuman, 1762-64). 807 folios analyzed.",
      "access": "Full PDF, 17 pages, freely available."
    },
    {
      "id": "ueda_2015",
      "citation": "Ueda, Hiroto. Un esbozo historico de las formas abreviadas espanolas con indices de continuidad y de suavidad. Instituto Cervantes de Tokio, 2015.",
      "url": "https://cvc.cervantes.es/ensenanza/biblioteca_ele/publicaciones_centros/PDF/tokio_2015/06_ueda.pdf",
      "description": "Statistical analysis of abbreviation frequency across 28 Spanish manuscripts/books from 13th-19th century. Identifies the most persistent abbreviation patterns.",
      "access": "Full PDF, 21 pages, freely available via CVC."
    },
    {
      "id": "familysearch_rootstech",
      "citation": "FamilySearch. Presentacion: Paleografia y Abreviaturas. RootsTech conference.",
      "url": "https://cms-z-assets.familysearch.org/e6/f8/a2c6cfd79e8078b63b88b571db50/presentacion-paleografia-y-abreviaturas-rootstech.pdf",
      "description": "Paleography training presentation with common abbreviation examples by type (sigla, suspension, contraction).",
      "access": "Full PDF, 20 pages, freely available."
    },
    {
      "id": "pterodactilo_2023",
      "citation": "Pterodactilo Graduate Student Magazine. The Monster Hiding in the Archives: Spanish Paleography and its Secrets (Part 4).",
      "url": "https://www.pterodactilo.com/the-monster-hiding-in-the-archives-spanish-paleography-and-its-secrets-part-4/",
      "description": "Academic blog post with illustrative examples of progressive abbreviation in colonial-era documents.",
      "access": "Web article, freely available."
    },
    {
      "id": "riesco_terrero_1983",
      "citation": "Riesco Terrero, Angel. Diccionario de abreviaturas hispanas de los siglos XIII al XVIII. Salamanca, 1983.",
      "url": null,
      "description": "Comprehensive dictionary of Hispanic abbreviations with appendix of juridical-diplomatic expressions. 620 pages. The standard reference work. Recommended by BNE.",
      "access": "Not included in repository (copyrighted). Available in academic libraries."
    },
    {
      "id": "codea_empirical",
      "citation": "Empirical analysis of CODEA+ 2022 paleographic ground truth (64 pages from optimization dataset).",
      "url": null,
      "description": "Abbreviation patterns extracted directly from CODEA paleographic transcriptions. See codea_gt_analysis.md and codea_abbreviation_frequency.json.",
      "access": "Local: docs/references/codea_gt_analysis.md"
    }
  ],
  "abbreviation_types": {
    "suspension": "Omits final letters. Marked by point, apostrophe, tilde, or superscript. Example: Ant(oni)o",
    "contraction": "Omits middle letters, preserves beginning and end. Example: d(ic)ho",
    "sigla": "Single initial letter(s) for a word/phrase. Example: V.M. = Vuestra Majestad",
    "superscript": "Final letter(s) raised above the line. Example: dho with superscript o",
    "special_signs": "Tironian sign (&), p-with-crossbar (per/par), q-with-tilde (que)"
  },
